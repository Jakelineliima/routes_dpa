{
  "manifest_version": 3,
  "name": "Automação de Rotas",
  "version": "1.0",
  "description": "Preenche formulários automaticamente",
  "permissions": ["scripting", "activeTab"],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://site-com-formulario.com/*"],
      "js": ["content.js"]
    }
  ]
}