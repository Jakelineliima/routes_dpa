{
  "manifest_version": 3,
  "name": "Automação de Rotas",
  "version": "1.0",
  "description": "Preenche formulários automaticamente",
  "permissions": ["scripting", "activeTab"],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}